{
  "name": "mcp-todo",
  "version": "0.9.0",
  "description": "A local task manager with a web interface and MCP server",
  "author": "paulmory",
  "repository": {
    "type": "git",
    "url": "https://github.com/paulmory/mcp-todo.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "backup": "node --experimental-strip-types scripts/backup.ts",
    "build": "vite build",
    "dev": "concurrently -k -n api,vite -c cyan,magenta \"node --experimental-strip-types src/server.ts\" \"vite --host 127.0.0.1\"",
    "start": "npm run build && node --experimental-strip-types src/server.ts",
    "user:create": "node --experimental-strip-types scripts/create-user.ts",
    "typecheck": "tsc --noEmit",
    "test:smoke": "npm run build && node --experimental-strip-types scripts/smoke-test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
